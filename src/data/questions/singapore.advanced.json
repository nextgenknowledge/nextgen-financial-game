    {"id": "sga-36", "city": "singapore", "topic": "debt", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "${P} loan: {aP:pct} for 60 months vs {bP:pct} for 84 months. How much more interest does the 84-month loan cost?", "vars": {"P": {"min": 10000, "max": 30000, "step": 1000}, "a": {"choices": [0.059, 0.064]}, "b": {"choices": [0.049, 0.054]}}, "answerExpr": "totint(P, b, 84)-totint(P, a, 60)", "format": "money", "explanation": "Lower rate but 24 more months: ${ANSWER} (negative means the 84-month loan costs less).", "derived": {"aP": "a*100", "bP": "b*100"}},
    {"id": "sga-37", "city": "singapore", "topic": "debt", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "${P} loan with a {fP:pct} origination fee. How much cash do you actually receive?", "vars": {"P": {"min": 5000, "max": 25000, "step": 1000}, "f": {"choices": [0.01, 0.02, 0.03, 0.05]}}, "answerExpr": "P*(1-f)", "format": "money", "explanation": "${P} × (1 − {fP:pct}) = ${ANSWER}.", "derived": {"fP": "f*100"}},
    {"id": "sga-38", "city": "singapore", "topic": "debt", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Payday loan: borrow ${b}, repay ${r} in 2 weeks. Approximate APR (%)?", "vars": {"b": {"choices": [200, 300, 400, 500]}, "k": {"choices": [0.1, 0.15, 0.2]}}, "answerExpr": "k*26*100", "format": "pct", "explanation": "Fee rate {kP:pct} × 26 periods ≈ {ANSWER:pct} APR!", "derived": {"r": "b*(1+k)", "kP": "k*100"}, "toleranceAbs": 0.5},
    {"id": "sga-39", "city": "singapore", "topic": "debt", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "Card balance ${B} at {rP:pct} APR; you pay only the interest each month. Yearly interest paid?", "vars": {"B": {"min": 1000, "max": 8000, "step": 100}, "r": {"choices": [0.1999, 0.2299, 0.2499]}}, "answerExpr": "B*r", "format": "money", "explanation": "${B} × {rP:pct} = ${ANSWER}, and the balance never shrinks.", "derived": {"rP": "r*100"}},
    {"id": "sga-40", "city": "singapore", "topic": "debt", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "${P} at {rP:pct} APR, payment ${m}/month. Months to pay off? (round up)", "vars": {"P": {"choices": [3000, 5000, 8000]}, "r": {"choices": [0.18, 0.22]}, "m": {"choices": [150, 200, 250]}}, "answerExpr": "ceil(-ln(1-P*(r/12)/m)/ln(1+r/12))", "format": "months", "explanation": "n = −ln(1 − P·i/PMT) ÷ ln(1+i) → {ANSWER} months.", "toleranceAbs": 1, "derived": {"rP": "r*100"}},
