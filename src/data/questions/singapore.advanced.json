{
  "questions": [
    {"id": "sga-01", "city": "singapore", "topic": "interest", "difficulty": "advanced", "level": 2, "type": "numeric", "prompt": "${P} at {rP:pct} compounded yearly for {t} years. Final balance?", "vars": {"P": {"min": 1000, "max": 10000, "step": 500}, "r": {"choices": [0.03, 0.04, 0.05, 0.06, 0.07]}, "t": {"min": 5, "max": 20}}, "answerExpr": "fv(P, r, t)", "format": "money", "explanation": "${P} × (1 + {rP:pct})^{t} = ${ANSWER}.", "hint": "A = P(1 + r)^t", "derived": {"rP": "r*100"}},
    {"id": "sga-02", "city": "singapore", "topic": "interest", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "${P} at {rP:pct} APR compounded monthly for {t} years. Final balance?", "vars": {"P": {"min": 1000, "max": 10000, "step": 500}, "r": {"choices": [0.03, 0.04, 0.05, 0.06]}, "t": {"min": 3, "max": 15}}, "answerExpr": "fv(P, r/12, 12*t)", "format": "money", "explanation": "${P} × (1 + {rP:pct}/12)^(12×{t}) = ${ANSWER}.", "derived": {"rP": "r*100"}},
    {"id": "sga-03", "city": "singapore", "topic": "interest", "difficulty": "advanced", "level": 2, "type": "numeric", "prompt": "Rule of 72: at {r}% per year, about how many years to double?", "vars": {"r": {"choices": [3, 4, 6, 8, 9, 12]}}, "answerExpr": "72/r", "format": "years", "explanation": "72 ÷ {r} = {ANSWER} years.", "toleranceAbs": 0.1},
    {"id": "sga-04", "city": "singapore", "topic": "interest", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "APR {rP:pct} compounded monthly. What is the APY (%)?", "vars": {"r": {"choices": [0.04, 0.05, 0.06, 0.12, 0.18]}}, "answerExpr": "(pow(1+r/12,12)-1)*100", "format": "pct", "explanation": "(1 + {rP:pct}/12)^12 − 1 = {ANSWER:pct}.", "toleranceAbs": 0.02, "derived": {"rP": "r*100"}},
    {"id": "sga-05", "city": "singapore", "topic": "interest", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Save ${a} at the end of every month at {rP:pct} APR (monthly). Balance after {t} years?", "vars": {"a": {"choices": [50, 100, 150, 200, 250]}, "r": {"choices": [0.04, 0.05, 0.06, 0.07]}, "t": {"min": 5, "max": 20}}, "answerExpr": "fvs(a, r/12, 12*t)", "format": "money", "explanation": "Future value of an annuity: ${ANSWER}.", "hint": "fvs(payment, rate per period, periods)", "derived": {"rP": "r*100"}},
    {"id": "sga-06", "city": "singapore", "topic": "interest", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Simple interest: ${P} at {rP:pct} for {t} years. Total interest?", "vars": {"P": {"min": 1000, "max": 8000, "step": 250}, "r": {"choices": [0.03, 0.04, 0.05, 0.06]}, "t": {"min": 2, "max": 8}}, "answerExpr": "P*r*t", "format": "money", "explanation": "I = P·r·t = ${ANSWER}.", "derived": {"rP": "r*100"}},
    {"id": "sga-07", "city": "singapore", "topic": "interest", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "Compound vs simple: ${P} at {rP:pct} yearly for {t} years. How much MORE does compound earn?", "vars": {"P": {"min": 2000, "max": 10000, "step": 500}, "r": {"choices": [0.05, 0.06, 0.07, 0.08]}, "t": {"min": 10, "max": 30}}, "answerExpr": "fv(P,r,t)-P-P*r*t", "format": "money", "explanation": "Compound − simple = ${ANSWER}: interest on interest.", "derived": {"rP": "r*100"}},
    {"id": "sga-08", "city": "singapore", "topic": "interest", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "How many years for ${P} to reach ${T} at {rP:pct} compounded yearly? (round up)", "vars": {"P": {"choices": [1000, 2000, 5000]}, "m": {"choices": [2, 3, 4]}, "r": {"choices": [0.05, 0.06, 0.07, 0.08]}}, "answerExpr": "ceil(ln(m)/ln(1+r))", "format": "years", "explanation": "t = ln({m}) ÷ ln(1 + {rP:pct}) → {ANSWER} years.", "derived": {"T": "P*m", "rP": "r*100"}, "toleranceAbs": 0},
    {"id": "sga-09", "city": "singapore", "topic": "saving", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Monthly expenses are ${e}. A 6-month emergency fund should be?", "vars": {"e": {"min": 1500, "max": 4500, "step": 100}}, "answerExpr": "6*e", "format": "money", "explanation": "6 × ${e} = ${ANSWER}."},
    {"id": "sga-10", "city": "singapore", "topic": "saving", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Goal ${g} in {m} months, earning nothing. Required monthly saving?", "vars": {"g": {"min": 1200, "max": 9600, "step": 120}, "m": {"choices": [6, 12, 18, 24]}}, "answerExpr": "g/m", "format": "money", "explanation": "${g} ÷ {m} = ${ANSWER}/month."},
    {"id": "sga-11", "city": "singapore", "topic": "saving", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "Goal ${g} in {t} years at {rP:pct} APR (monthly). Required monthly deposit?", "vars": {"g": {"min": 5000, "max": 30000, "step": 1000}, "t": {"choices": [2, 3, 4, 5]}, "r": {"choices": [0.03, 0.04, 0.05]}}, "answerExpr": "g*(r/12)/(pow(1+r/12,12*t)-1)", "format": "money", "explanation": "PMT = FV × i ÷ ((1+i)^n − 1) = ${ANSWER}.", "derived": {"rP": "r*100"}},
    {"id": "sga-12", "city": "singapore", "topic": "saving", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Emergency fund ${f}; monthly expenses ${e}. How many months does it cover?", "vars": {"e": {"min": 1500, "max": 4000, "step": 100}, "k": {"choices": [2, 3, 4, 5, 6]}}, "answerExpr": "k", "format": "months", "explanation": "${f} ÷ ${e} = {ANSWER} months.", "derived": {"f": "e*k"}, "toleranceAbs": 0.05},
    {"id": "sga-13", "city": "singapore", "topic": "saving", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "Inflation is {iP:pct}. A savings account pays {rP:pct}. Real return (%)?", "vars": {"i": {"choices": [0.02, 0.03, 0.04]}, "r": {"choices": [0.01, 0.045, 0.05]}}, "answerExpr": "((1+r)/(1+i)-1)*100", "format": "pct", "explanation": "(1+{rP:pct})/(1+{iP:pct}) − 1 = {ANSWER:pct}.", "toleranceAbs": 0.05, "derived": {"rP": "r*100", "iP": "i*100"}},
    {"id": "sga-14", "city": "singapore", "topic": "saving", "difficulty": "advanced", "level": 3, "type": "mc", "prompt": "Where should an emergency fund usually live?", "choices": ["A high-yield savings account", "A few individual growth stocks", "A cryptocurrency wallet", "A 10-year CD with penalties"], "answer": 0, "explanation": "Emergency money must be safe and quickly accessible."},
    {"id": "sga-15", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Salary ${s}. You contribute {cP:pct}; employer matches 50% up to 6% of salary. Employer contribution?", "vars": {"s": {"min": 40000, "max": 120000, "step": 5000}, "c": {"choices": [0.03, 0.04, 0.06, 0.08, 0.1]}}, "answerExpr": "s*min(c,0.06)*0.5", "format": "money", "explanation": "50% × min({cP:pct}, 6%) × ${s} = ${ANSWER}.", "derived": {"cP": "c*100"}},
    {"id": "sga-16", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "4% rule: you want ${y}/year in retirement. Nest egg needed?", "vars": {"y": {"min": 30000, "max": 90000, "step": 5000}}, "answerExpr": "y/0.04", "format": "money", "explanation": "${y} ÷ 0.04 = ${ANSWER} (25× spending)."},
    {"id": "sga-17", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "Invest ${a}/month from age {s} to 65 at {rP:pct} (monthly). Balance at 65?", "vars": {"a": {"choices": [100, 200, 300, 500]}, "s": {"choices": [22, 25, 30, 35]}, "r": {"choices": [0.06, 0.07, 0.08]}}, "answerExpr": "fvs(a, r/12, 12*(65-s))", "format": "money", "explanation": "fvs(${a}, {rP:pct}/12, 12×(65−{s})) = ${ANSWER}.", "derived": {"rP": "r*100"}},
    {"id": "sga-18", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "Early bird invests ${a}/month for {n} years from 25 then stops; it grows at {rP:pct} yearly until 65 (monthly compounding). Balance at 65?", "vars": {"a": {"choices": [200, 300, 400]}, "n": {"choices": [5, 10]}, "r": {"choices": [0.06, 0.07]}}, "answerExpr": "fvs(a, r/12, 12*n)*pow(1+r/12, 12*(40-n))", "format": "money", "explanation": "Grow the contributions, then let them sit: ${ANSWER}.", "derived": {"rP": "r*100"}},
    {"id": "sga-19", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "You put ${a} into a traditional 401(k) and are in the {bP:pct} bracket. Tax saved this year?", "vars": {"a": {"min": 2000, "max": 20000, "step": 500}, "b": {"choices": [0.12, 0.22, 0.24]}}, "answerExpr": "a*b", "format": "money", "explanation": "${a} × {bP:pct} = ${ANSWER}.", "derived": {"bP": "b*100"}},
    {"id": "sga-20", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 3, "type": "mc", "prompt": "You expect a HIGHER tax rate in retirement than now. Usually better:", "choices": ["Roth (pay tax now)", "Traditional (deduct now)", "No account at all", "Cash under the mattress"], "answer": 0, "explanation": "Pay tax when your rate is lower, now."},
    {"id": "sga-21", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 3, "type": "mc", "prompt": "Not taking the full employer match is like…", "choices": ["Turning down part of your pay", "Avoiding tax on that money", "Saving money on fees", "Paying off debt faster"], "answer": 0, "explanation": "The match is part of your compensation."},
    {"id": "sga-22", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "Fund fee {f:pct}/yr vs 0.05%. On ${P} growing {rP:pct} for 30 years, how much more do you end with on the cheap fund?", "vars": {"f": {"choices": [0.5, 0.75, 1.0]}, "P": {"choices": [10000, 25000, 50000]}, "r": {"choices": [0.06, 0.07]}}, "answerExpr": "fv(P, r-0.0005, 30)-fv(P, r-f/100, 30)", "format": "money", "explanation": "Fees compound too: ${ANSWER} difference.", "hint": "Subtract the fee from the return each year.", "derived": {"rP": "r*100"}},
    {"id": "sga-23", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Withdrawing {wP:pct} a year from ${N}. Annual income?", "vars": {"w": {"choices": [0.03, 0.035, 0.04, 0.045]}, "N": {"min": 400000, "max": 1500000, "step": 50000}}, "answerExpr": "w*N", "format": "money", "explanation": "{wP:pct} × ${N} = ${ANSWER}.", "derived": {"wP": "w*100"}},
    {"id": "sga-24", "city": "singapore", "topic": "retirement", "difficulty": "advanced", "level": 4, "type": "mc", "prompt": "A 10% early-withdrawal penalty on retirement accounts mainly exists to…", "choices": ["Discourage early withdrawals", "Raise money to fund public schools", "Reward savers who withdraw on time", "Pay brokers for managing the account"], "answer": 0, "explanation": "Tax advantages come with rules to keep money invested until retirement."},
    {"id": "sga-25", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Deductible ${d}, then insurance pays {cP:pct}. A ${b} bill. You pay?", "vars": {"d": {"choices": [500, 1000, 2000]}, "c": {"choices": [0.8, 0.9]}, "b": {"min": 3000, "max": 20000, "step": 500}}, "answerExpr": "d+(b-d)*(1-c)", "format": "money", "explanation": "${d} + (${b} − ${d}) × (1 − {cP:pct}) = ${ANSWER}.", "derived": {"cP": "c*100"}},
    {"id": "sga-26", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Health plan with an out-of-pocket max is ${x}. Deductible ${d}, coinsurance {kP:pct}, bill ${b}. You pay?", "vars": {"d": {"choices": [1000, 1500]}, "k": {"choices": [0.2, 0.3]}, "b": {"min": 20000, "max": 60000, "step": 1000}, "x": {"choices": [4000, 5000, 6000]}}, "answerExpr": "min(x, d+(b-d)*k)", "format": "money", "explanation": "The out-of-pocket max caps it: ${ANSWER}.", "derived": {"kP": "k*100"}},
    {"id": "sga-27", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Plan A premium ${a}/month, deductible ${da}. Plan B ${b}/month, deductible ${db}. In a year with one big claim (over both deductibles), how much cheaper is Plan B in total? (negative = A cheaper)", "vars": {"a": {"choices": [120, 150, 180]}, "da": {"choices": [250, 500]}, "b": {"choices": [50, 60, 80]}, "db": {"choices": [2000, 2500, 3000]}}, "answerExpr": "(12*a+da)-(12*b+db)", "format": "money", "explanation": "A: 12×${a}+${da}; B: 12×${b}+${db}. Difference ${ANSWER}."},
    {"id": "sga-28", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 4, "type": "numeric", "prompt": "A {pP:pct} chance per year of a ${L} loss. Expected yearly loss?", "vars": {"p": {"choices": [0.01, 0.02, 0.05]}, "L": {"choices": [10000, 20000, 50000]}}, "answerExpr": "p*L", "format": "money", "explanation": "{pP:pct} × ${L} = ${ANSWER}. Premiums are usually above this, you pay for certainty.", "derived": {"pP": "p*100"}},
    {"id": "sga-29", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Raising your deductible from ${a} to ${b} saves ${s}/year in premiums. How many claim-free years to break even on one claim?", "vars": {"a": {"choices": [250, 500]}, "b": {"choices": [1000, 1500]}, "s": {"choices": [100, 125, 150, 200]}}, "answerExpr": "(b-a)/s", "format": "years", "explanation": "(${b} − ${a}) ÷ ${s} = {ANSWER} years.", "toleranceAbs": 0.05},
    {"id": "sga-30", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 3, "type": "mc", "prompt": "Insurance makes the MOST sense for losses that are…", "choices": ["Rare but very expensive", "Frequent and very small", "Certain to happen soon", "Losses that already happened"], "answer": 0, "explanation": "Insure catastrophes; self-insure small stuff."},
    {"id": "sga-31", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 3, "type": "mc", "prompt": "Term life insurance is mainly for…", "choices": ["Replacing income for dependents", "Investing for your own retirement", "Paying for car repairs after a crash", "Lowering this year’s income tax"], "answer": 0, "explanation": "Term life protects people who rely on your income."},
    {"id": "sga-32", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 4, "type": "mc", "prompt": "A high-deductible plan is usually best for someone who…", "choices": ["Is healthy, with savings for the deductible", "Has frequent, costly ongoing treatments", "Has no savings to fall back on at all", "Rarely sees a doctor and has no savings"], "answer": 0, "explanation": "Lower premiums fit those who rarely use care AND can cover the deductible."},
    {"id": "sga-33", "city": "singapore", "topic": "insurance", "difficulty": "advanced", "level": 3, "type": "mc", "prompt": "Renters insurance usually covers…", "choices": ["Your belongings and liability", "The building’s roof and walls", "Your car’s engine and tires", "Your landlord’s property taxes"], "answer": 0, "explanation": "The landlord insures the building; renters insure their stuff."},
    {"id": "sga-34", "city": "singapore", "topic": "debt", "difficulty": "advanced", "level": 3, "type": "numeric", "prompt": "Loan ${P} at {rP:pct} APR for {n} months. Monthly payment?", "vars": {"P": {"min": 5000, "max": 30000, "step": 1000}, "r": {"choices": [0.049, 0.059, 0.069, 0.089]}, "n": {"choices": [36, 48, 60, 72]}}, "answerExpr": "pmt(P, r, n)", "format": "money", "explanation": "PMT(${P}, {rP:pct}/12, {n}) = ${ANSWER}.", "derived": {"rP": "r*100"}},
